# Copy to .env and fill in your own keys. .env is ignored by git; never commit it.

# Required: the Director and the Showrunner (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Video only, on the GPU machine: the gated LTX-2.5 weights. Accept the licence at
# https://huggingface.co/Lightricks/LTX-2.5-Diffusers, then create a read token.
HF_TOKEN=

# Video only, to rent the GPU with server/vast_run.sh (https://cloud.vast.ai/manage-keys/).
VAST_API_KEY=

# Where the client finds the LTX-2.5 server (default http://localhost:8000).
# LTXV_SERVER_URL=
