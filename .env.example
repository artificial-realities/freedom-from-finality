# Untitled Project configuration. Copy this file to .env and fill in your own values.
# .env is ignored by git and Docker builds — never commit it or paste its contents anywhere.
# Variables already set in your shell win over this file.
# `python main.py check --config <config>` reports what is missing without calling any paid API.

# --- Required -------------------------------------------------------------------

# Every config calls the OpenAI API (the Director and the Showrunner).
# Create a key at https://platform.openai.com/api-keys; usage is billed to its account.
OPENAI_API_KEY=

# --- Video (only for configs/director.live.yaml) -------------------------------

# On the GPU machine: a Hugging Face token to download the gated LTX-2.5 weights.
# Accept the licence at https://huggingface.co/Lightricks/LTX-2.5-Diffusers, then
# create a read token at https://huggingface.co/settings/tokens.
HF_TOKEN=

# Where the client finds the LTX-2.5 server. Unset: the config's ltxv_server_url
# (http://localhost:8000, the ssh tunnel or the same machine).
# LTXV_SERVER_URL=http://localhost:8000

# A shared key between the client and the LTX-2.5 server. When set on the server,
# /generate needs it; the client sends the same value. Set it whenever the server
# is reachable by anything other than an ssh tunnel or the machine itself.
# LTX2_API_KEY=

# --- Renting a GPU on Vast.ai (only for server/vast_run.sh) -------------------

# https://cloud.vast.ai/manage-keys/ — renting bills this account by the hour.
# VAST_API_KEY=

# --- Langfuse tracing (optional) ----------------------------------------------

# With a public key set, every LLM call (prompts and outputs) is sent to Langfuse.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Docker Compose (optional) ------------------------------------------------

# The config `docker compose up` plays (default: the text-only configs/director.yaml).
# PLAY_CONFIG=configs/director.live.yaml
