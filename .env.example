# Artificial Realities — environment template.
# Copy to `.env` and fill in whatever you actually need.
# `.env` is gitignored; `.env.example` is not.

# --- OpenAI -------------------------------------------------------------------
# Required — every config calls the OpenAI API.
OPENAI_API_KEY=

# --- HuggingFace (only for downloading LTX-2.5 weights) ----------------------
# The model is gated — agree at huggingface.co/Lightricks/LTX-2.5-Diffusers
# and create a token at huggingface.co/settings/tokens.
# Only needed on the GPU box running server/ltx2_server.py.
HF_TOKEN=

# --- ElevenLabs TTS (only when audio_enabled: true) ---------------------------
# The voice_id lives in the run config (configs/*.yaml → elevenlabs_voice_id).
ELEVENLABS_API_KEY=

# --- Langfuse tracing (optional) ----------------------------------------------
# Tracing activates when LANGFUSE_PUBLIC_KEY is set; otherwise no-ops.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Vast.ai GPU rental (optional) -------------------------------------------
# For provisioning GPU instances via the Vast.ai CLI/API.
VAST_API_KEY=
